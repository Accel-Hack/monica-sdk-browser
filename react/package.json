{
  "name": "@ah-monica/react",
  "version": "0.2.0",
  "description": "React Error Boundary, provider, and hooks for the MONICA browser SDK",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "build:browser": "bun run --filter @ah-monica/browser build",
    "pack:check": "bun run build:browser && bun run build && bun pm pack --dry-run",
    "test": "bun test",
    "typecheck": "bun run build:browser && tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Accel-Hack/monica-sdk-browser.git",
    "directory": "react"
  },
  "dependencies": {
    "@ah-monica/browser": "0.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2"
  }
}
